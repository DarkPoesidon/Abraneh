<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/server_settings"
            android:textColor="@color/text_primary_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/server_url_desc"
            android:textColor="@color/text_secondary_dark"
            android:textSize="13sp" />

        <!-- Clean Persian Label above input box -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="right"
            android:text="@string/server_url_prompt"
            android:textColor="@color/primary_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Telegram-style clean rounded input box -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/edit_server_url"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/edittext_background"
                android:gravity="center_vertical|left"
                android:hint="@string/server_url_hint"
                android:inputType="textUri"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:singleLine="true"
                android:textColor="@color/text_primary_dark"
                android:textColorHint="@color/text_secondary_dark"
                android:textDirection="ltr"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btn_paste_url"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/paste"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_edit"
                android:tint="@color/primary_light" />

        </RelativeLayout>

        <CheckBox
            android:id="@+id/check_proxy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/proxy_use"
            android:textColor="@color/text_primary_dark"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/proxy_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio_proxy_socks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:text="SOCKS5"
                    android:textColor="@color/text_primary_dark" />

                <RadioButton
                    android:id="@+id/radio_proxy_http"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HTTP"
                    android:textColor="@color/text_primary_dark" />
            </RadioGroup>

            <EditText
                android:id="@+id/edit_proxy_host"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_background"
                android:hint="@string/proxy_host"
                android:inputType="textUri"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/text_primary_dark"
                android:textColorHint="@color/text_secondary_dark"
                android:textDirection="ltr"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edit_proxy_port"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_background"
                android:hint="@string/proxy_port"
                android:inputType="number"
                android:maxLength="5"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/text_primary_dark"
                android:textColorHint="@color/text_secondary_dark"
                android:textDirection="ltr"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/proxy_help"
                android:textColor="@color/text_secondary_dark"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Status & Result Text -->
        <TextView
            android:id="@+id/txt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textSize="13sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_test_connection"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/test_connection"
            android:textColor="@color/primary_light"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_save_connect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_background"
            android:text="@string/save_and_connect"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Clear Storage / Reset Button -->
        <Button
            android:id="@+id/btn_clear_data"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/reset_session"
            android:textColor="@color/error"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt_app_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="WIHM Cloudflare Messenger v1.4.1"
            android:textColor="@color/text_secondary_dark"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
