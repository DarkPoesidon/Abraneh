{
  "name": "wihm-messenger-windows",
  "productName": "Abraneh",
  "version": "1.7.26",
  "description": "Abraneh messenger for Windows",
  "author": "WIHM",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.wihm.messenger.desktop",
    "files": ["main.js", "preload.js", "rules.js", "updates.js", "setup.html", "setup.js", "tray.png"],
    "artifactName": "wihm-messenger-windows-setup.${ext}",
    "electronFuses": { "runAsNode": false },
    "nsis": { "oneClick": true, "perMachine": false }
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  }
}
