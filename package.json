{
  "name": "cloudflare-messenger",
  "version": "1.5.2",
  "type": "module",
  "scripts": {
    "installer:build": "node scripts/build-installer.mjs",
    "installer:start": "node dist/WIHM-Installer/start.mjs",
    "test:installer": "node --test tests/installer.test.mjs tests/termux-bootstrap.test.mjs tests/installer-domain.test.mjs tests/backup-restore.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute messenger-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute messenger-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.1-beta",
    "typescript": "^7.0.2",
    "wrangler": "^4.154.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@simplewebauthn/server": "14.0.3",
    "ts-mls": "1.6.4"
  }
}
